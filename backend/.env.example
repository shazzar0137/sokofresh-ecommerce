# Copy this file to backend/.env for local development (backend/.env is git-ignored).
# Never put real production secrets in any file in this repository.

# Local PostgreSQL (see backend/documentation/developer/GETTING_STARTED.md), or your
# Neon development branch connection string (ends with ?sslmode=require).
DATABASE_URL=postgres://sokofresh:sokofresh-local-dev@localhost:5432/sokofresh_dev

# Optional in development (settings/dev.py supplies a development-only key).
# DJANGO_SECRET_KEY=

# Development prints SMS codes to the console with the number masked.
# SMS_BACKEND=apps.notifications.sms.ConsoleSmsBackend

# DJANGO_LOG_LEVEL=INFO
