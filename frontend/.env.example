# SokoFresh frontend environment. Copy to `.env.local` for local development.
# Never put secrets here: anything starting with NEXT_PUBLIC_ is sent to every browser.

# Server only (not sent to browsers). Where Next.js forwards /api/v1 and /_allauth.
# Defaults to http://127.0.0.1:8000 in development. Required for production builds.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Public address of the storefront (used for metadata and to decide HTTPS-only headers).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "enabled" to answer API calls with labelled mock data (MSW) during `npm run dev`.
# Ignored in production builds.
NEXT_PUBLIC_API_MOCKING=disabled
