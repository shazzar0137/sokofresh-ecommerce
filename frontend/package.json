{
  "name": "sokofresh-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SokoFresh customer storefront and rider screens (Next.js App Router).",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "msw init public --save",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "api:types": "openapi-typescript ../shared/contracts/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../shared/contracts/openapi.yaml -o src/api/schema.d.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:production": "node scripts/check-production-build.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@tanstack/react-query": "5.108.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "msw": "3.0.8",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
