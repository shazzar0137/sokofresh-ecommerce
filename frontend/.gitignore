# Frontend-specific ignores (the root .gitignore covers secrets, node_modules, coverage, logs).

# Next.js build output
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Local environment (copy .env.example to .env.local)
.env*.local

# Vercel
.vercel
